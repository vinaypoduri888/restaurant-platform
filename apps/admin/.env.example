# Base URL of the platform API.
#
# Server-side only. Every request to the API — including sign-in — is made by
# this app's server, never by the browser, so the API's location is never
# published to the client. Deliberately NOT prefixed with NEXT_PUBLIC_, which
# would expose it in the client bundle.
#
# Optional; defaults to http://localhost:3001 (the API's dev port).
API_BASE_URL="http://localhost:3001"
