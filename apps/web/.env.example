# Base URL of the platform API.
#
# Server-side only — this app fetches restaurant data inside Server Components,
# so the browser never sees this value. Deliberately NOT prefixed with
# NEXT_PUBLIC_, which would expose it in the client bundle.
#
# Optional; defaults to http://localhost:3001 (the API's dev port).
API_BASE_URL="http://localhost:3001"

# Origin branding images are served from.
#
# Used only by `next.config.js`, to build a narrowly-scoped
# `images.remotePatterns` entry — `next/image` refuses a remote src that is not
# explicitly allowed, and media is remote by construction.
#
# It must agree with whatever the API resolves media URLs against:
#   STORAGE_DRIVER=local  ->  the API's LOCAL_STORAGE_PUBLIC_BASE_URL
#   STORAGE_DRIVER=r2     ->  the API's R2_PUBLIC_BASE_URL
#
# When this host is loopback (i.e. local development), the config also enables
# `images.dangerouslyAllowLocalIP`, because Next's optimiser otherwise refuses
# private IPs as SSRF protection. A public media host leaves that off.
#
# Optional; defaults to http://localhost:3001/media (the API's own default).
MEDIA_PUBLIC_BASE_URL="http://localhost:3001/media"
