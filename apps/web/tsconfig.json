{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    /** Matches the convention already used by apps/admin. */
    "paths": {
      "@/*": ["./*"]
    },
    /** Provides `bun:test` types for the colocated tests. */
    "types": ["bun"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
