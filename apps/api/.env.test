DATABASE_URL="postgresql://postgres:postgres@localhost:5433/restaurant_platform_test?schema=public"
API_PORT=3999
NODE_ENV=test
CORS_ORIGINS="http://localhost:3000"
BETTER_AUTH_SECRET="test-only-secret-not-used-in-any-real-environment-0123456789"
BETTER_AUTH_URL="http://localhost:3999"
LOG_LEVEL=error
AUTH_RATE_LIMIT_MAX=100000

# Media storage for the test suite.
#
# A separate directory from development so test uploads never mix with real
# ones. `resetDatabase` truncates metadata between tests but does not sweep
# storage, so objects accumulate here across runs — harmless for a git-ignored
# scratch directory, and deleting it is always safe.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH="./storage/test-uploads"
LOCAL_STORAGE_PUBLIC_BASE_URL="http://localhost:3999/media"
