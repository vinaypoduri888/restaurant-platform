# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.

# PostgreSQL connection string.
# NOTE: host port is 5433, not the default 5432 — see AI_ENGINEER.md
# ("Local development environment") for why. Do not change this to 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/restaurant_platform?schema=public"

# Port the API listens on. Optional, defaults to 3001.
API_PORT=3001

# One of: development | test | production. Optional, defaults to development.
NODE_ENV=development

# Comma-separated browser origins allowed to call this API.
# Optional; defaults to the local web (3000) and admin (3002) dev servers.
# Never set this to "*" — the API uses credentialed requests.
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# One of: debug | info | warn | error.
# Optional; defaults to debug outside production, info in production.
# LOG_LEVEL=debug

# Maximum accepted request body size in bytes. Optional, defaults to 1000000 (1 MB).
# BODY_LIMIT_BYTES=1000000

# Comma-separated IPs / IPv4 CIDRs of reverse proxies allowed to set
# `X-Forwarded-For`. Optional; empty by default, which means NO proxy is trusted
# and the header is ignored entirely — the correct setting for direct local
# development and the reason a rotating X-Forwarded-For cannot defeat the rate
# limiter.
#
# Set this ONLY to the address(es) your load balancer actually connects from.
# Anything listed here is trusted to declare who the client is.
#   single host   : TRUSTED_PROXY_IPS="10.0.0.4"
#   a range       : TRUSTED_PROXY_IPS="10.0.0.0/8"
#   both loopbacks: TRUSTED_PROXY_IPS="127.0.0.1,::1"
# Note IPv6: a connection to "localhost" usually arrives from ::1, not
# 127.0.0.1, so list both if you need loopback trusted.
# TRUSTED_PROXY_IPS=""

# REQUIRED. Signing secret for session cookies. Minimum 32 characters.
# Must be unique per environment and must never be committed.
# Generate one with:
#   bun -e 'console.log(crypto.randomUUID().replace(/-/g,"")+crypto.randomUUID().replace(/-/g,""))'
BETTER_AUTH_SECRET="replace-me-with-a-64-char-random-string"

# Public base URL of this API, used to build auth callback URLs.
# Optional, defaults to http://localhost:3001.
BETTER_AUTH_URL="http://localhost:3001"

# Public base URL of the CUSTOMER site — where /r/{slug} is served.
#
# The API needs this to generate QR codes: a scanned code must carry an
# absolute URL, and the API cannot infer the customer site's origin from its
# own (different host and port) or from request headers (a forged Host would
# then decide what a printed code points at).
#
# Optional; defaults to the local web dev server.
PUBLIC_WEB_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------

# Which storage adapter serves uploaded branding images: "local" or "r2".
#
# Chosen explicitly, never inferred from NODE_ENV — "production implies R2"
# would make a staging environment's storage a surprise, and would make running
# the local adapter in production impossible to express even when deliberate.
#
# "local" needs no credentials at all, so the full media feature works with
# nothing configured.
STORAGE_DRIVER=local

# Where the local adapter writes. Git-ignored, and deliberately outside both the
# source tree and any app's public/ directory so uploads can never be committed
# or bundled into a build.
LOCAL_STORAGE_PATH="./storage/uploads"

# Base URL the local adapter builds public media URLs from. With this driver the
# API itself serves the bytes, so it points back here.
LOCAL_STORAGE_PUBLIC_BASE_URL="http://localhost:3001/media"

# Maximum upload size in bytes. Separate from BODY_LIMIT_BYTES: a 1 MB cap is
# right for JSON and far too small for a banner, but raising the global limit
# would weaken every other endpoint.
MEDIA_MAX_BYTES=5000000

# Reject absurd dimensions; a logo has no legitimate need to be huge.
MEDIA_MAX_DIMENSION=4096

# ---------------------------------------------------------------------------
# Cloudflare R2 — required only when STORAGE_DRIVER=r2
#
# The process refuses to start if the driver is "r2" and any of these is
# missing, and reports every missing key at once. Discovering a missing secret
# on the first upload instead would turn a deploy mistake into a user-facing
# 500 hours later.
#
# No SDK is needed: Bun ships an S3 client that speaks to R2 directly.
# ---------------------------------------------------------------------------
# R2_ACCOUNT_ID=""
# R2_BUCKET=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# Public CDN or bucket domain objects are readable from.
# R2_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# Transactional email
# ---------------------------------------------------------------------------

# Which mailer delivers verification, password-reset and invitation mail.
#
# Chosen explicitly, never inferred from NODE_ENV — the same rule as
# STORAGE_DRIVER. "console" prints messages instead of sending them, which makes
# every account flow developable and testable with no credentials.
#
# The process REFUSES TO START with EMAIL_DRIVER=console in production: silently
# undelivered password resets are worse than a failure to boot. No production
# provider has been selected yet, so the enum currently accepts only "console" —
# adding one means writing an adapter and extending the enum, and an
# unimplemented value fails at startup with the valid values named.
EMAIL_DRIVER=console

# From address on outgoing mail. Validated for shape only; whether the domain is
# authorised to send is the provider's business.
EMAIL_FROM="no-reply@restaurant-platform.local"

# Where the admin console lives. Verification, reset and invitation links point
# here, so it must be an address a person's browser can reach — NOT the API's
# own origin, which is where BETTER_AUTH_URL points.
ADMIN_BASE_URL="http://localhost:3002"

# How long an invitation stays acceptable. Seven days by default.
INVITATION_TTL_HOURS=168

# Invitations one restaurant may send per rolling window. These endpoints sit
# outside /api/auth/*, so the auth limiter does not cover them; without a cap an
# authenticated owner could use the platform to mail arbitrary addresses.
# Counted from the rows themselves, so it survives a restart and is shared
# across instances — unlike the in-process auth limiter (Phase 10).
INVITE_RATE_LIMIT_MAX=20
INVITE_RATE_LIMIT_WINDOW_MS=3600000
